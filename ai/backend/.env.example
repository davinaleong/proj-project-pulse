# AI Backend Environment Configuration
# Copy this file to .env and configure your Azure credentials

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API Keys (comma-separated for multiple keys)
VALID_API_KEYS=dev-key-123,test-key-456

# Azure Configuration
# Authentication will use DefaultAzureCredential in this order:
# 1. Environment variables (below)
# 2. Managed Identity (in Azure)
# 3. Azure CLI credentials
# 4. Azure PowerShell credentials

# Option 1: Service Principal (recommended for production)
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id

# Option 2: User-assigned Managed Identity (for Azure resources)
# AZURE_CLIENT_ID=your-managed-identity-client-id

# Azure AI Search Configuration
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=your-index-name
# AZURE_SEARCH_API_KEY=your-search-admin-key  # Optional if using managed identity

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-service.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_API_KEY=your-openai-key  # Optional if using managed identity

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Security
HELMET_ENABLED=true
REQUEST_SIZE_LIMIT=10mb

# Performance
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000

# Health Check
HEALTH_CHECK_TIMEOUT=5000