# ============================================
# AI Backend Environment Configuration
# Copy this file to .env and fill in the values
# ============================================

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# --------------------------------------------
# Security Configuration - SIMPLIFIED FOR SMALL PROJECTS
# --------------------------------------------
# JWT Secret (for external clients - optional)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Shared Secret (for Next.js integration - MAIN AUTH METHOD)
SHARED_SECRET=your-shared-secret-between-nextjs-and-ai-backend-24chars-min

# Legacy API keys (optional, for backward compatibility)
VALID_API_KEYS=dev-key-123,test-key-456

# ============================================
# AZURE CONFIGURATION (API KEY AUTH ONLY)
# ============================================

# ===== Azure AI Search =====
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=your-index-name
AZURE_SEARCH_API_KEY=your-search-admin-key
AZURE_SEMANTIC_CONFIG_NAME=your-semantic-configuration-name

# ===== Azure OpenAI =====
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_API_KEY=your-azure-openai-key

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Next.js Integration
# ============================================
# Add these to your Next.js .env.local file:
# AI_BACKEND_SHARED_SECRET=your-shared-secret-between-nextjs-and-ai-backend-24chars-min
# NEXT_PUBLIC_AI_API_URL=http://localhost:3001/api/v1

# --------------------------------------------
# Security
# --------------------------------------------
HELMET_ENABLED=true
REQUEST_SIZE_LIMIT=10mb

# --------------------------------------------
# Performance
# --------------------------------------------
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000

# --------------------------------------------
# Health Check
# --------------------------------------------
HEALTH_CHECK_TIMEOUT=5000
