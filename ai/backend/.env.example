# ============================================
# AI Backend Environment Configuration
# Copy this file to .env and fill in the values
# ============================================

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# --------------------------------------------
# API Keys (for your custom API gateway)
# --------------------------------------------
VALID_API_KEYS=dev-key-123,test-key-456

# ============================================
# AZURE CONFIGURATION (API KEY AUTH ONLY)
# ============================================

# ===== Azure AI Search =====
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=your-index-name
AZURE_SEARCH_API_KEY=your-search-admin-key

# ===== Azure OpenAI =====
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_API_KEY=your-azure-openai-key

# DO NOT USE DefaultAzureCredential locally
# No AZURE_CLIENT_ID / SECRET / TENANT_ID needed
# ============================================

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --------------------------------------------
# Security
# --------------------------------------------
HELMET_ENABLED=true
REQUEST_SIZE_LIMIT=10mb

# --------------------------------------------
# Performance
# --------------------------------------------
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000

# --------------------------------------------
# Health Check
# --------------------------------------------
HEALTH_CHECK_TIMEOUT=5000
