			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-set base URL if not set",
					"if (!pm.environment.get('baseUrl')) {",
					"    pm.environment.set('baseUrl', 'http://localhost:3001/api/v1');",
					"}",
					"",
				"// Auto-set shared secret if not set (development default)",
				"if (!pm.environment.get('sharedSecret')) {",
				"    pm.environment.set('sharedSecret', 'dev-shared-secret-2024');",
				"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test to check response format",
					"pm.test('Response should be JSON', function () {",
					"    pm.response.to.be.json;",
					"});",
					"",
					"pm.test('Response should have success field', function () {",
					"    const jsonData = pm.response.json();",
					"    pm.expect(jsonData).to.have.property('success');",
					"});",
					"",
					"pm.test('Response should have metadata', function () {",
					"    const jsonData = pm.response.json();",
					"    pm.expect(jsonData).to.have.property('metadata');",
					"    pm.expect(jsonData.metadata).to.have.property('timestamp');",
					"});"
				]
			}
		}
